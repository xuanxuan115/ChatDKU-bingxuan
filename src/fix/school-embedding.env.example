# Merge these entries into the PROJECT ROOT .env. Do not replace unrelated settings.
# Edit existing entries; keep each name only once. Never commit the real API key.
CHATDKU_EMBEDDING_PROVIDER=openai
CHATDKU_EMBEDDING_BASE_URL=https://aichat.dukekunshan.edu.cn:3443/v1
CHATDKU_OPENAI_EMBEDDING_MODEL=Qwen3-Embedding-8B
CHATDKU_EMBEDDING_API_KEY=REPLACE_WITH_YOUR_SCHOOL_KEY
CHATDKU_EMBEDDING_BATCH_SIZE=1
CHATDKU_EMBEDDING_TIMEOUT_SECONDS=60
CHATDKU_EMBEDDING_QUERY_INSTRUCTION=
CHATDKU_LOCAL_EMBEDDING_MODEL=
CHATDKU_TEI_EMBEDDING_MODEL=
CHATDKU_REMOTE_EMBEDDING_MODEL=
NO_PROXY=localhost,127.0.0.1,aichat.dukekunshan.edu.cn
